# Copy this file to .env and fill in the values. .env is read by two things:
# compose, for the ${...} values in compose.yaml, and read-secrets.sh, which
# hands every line below to the migration, the seed job and the api through
# the [env secrets] provider in stack.conf. Neither puts a value on a command
# line or in a log. The .gitignore in this folder keeps .env out of git; this
# example file holds placeholders only.
# One KEY=VALUE per line and no quotes: read-secrets.sh passes a value as
# written, while compose would strip the quotes, so a quoted value would
# reach the two readers differently. Blank lines and lines starting with #
# are skipped. DB_HOST and DB_PORT are not secrets; they live here so the
# api, the migration and compose agree on one value.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
SESSION_SECRET=change-me-as-well
